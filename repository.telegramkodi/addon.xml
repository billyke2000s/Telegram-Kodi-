<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.telegramkodi" name="Telegram Kodi Repository" version="1.0.2" provider-name="Billy">
    <extension point="xbmc.addon.repository" name="Telegram Kodi Repository">
        <!-- Kodi 19+ only reads <dir> blocks; files served straight from GitHub. -->
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/billyke2000s/Telegram-Kodi-/main/docs/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/billyke2000s/Telegram-Kodi-/main/docs/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/billyke2000s/Telegram-Kodi-/main/docs/</datadir>
            <hashes>false</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Installs and updates the Telegram Media add-on</summary>
        <description lang="en_GB">Repository for the Telegram Media Kodi add-on.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
